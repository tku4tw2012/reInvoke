#do not use non-printable characters (ASCII < 0x20, or >0x7e), otherwise the execution will abort.
#do not insert empty line in between, otherwise the execution will abort.
# Erase chip
nandinit
nanderase 0 2048
# flash full image
usbload 0x83 0x7000000
tftp2nand -d 106436760 0x7000000
# Boot into kernel with ramdisk for burning OTP, copying keys, etc.
usbload 0x81 0x0c400000
usbload 0x82 0x08000000
# Note: since we are using Chromecast's kernel, boot into recovery mode so
# we can modify the factory partition.  Also, the hardware type will take
# care of definiting the partition table.
set bootargs console=ttyS0,115200 debug init=/bin/sh root=/dev/ram  mtdparts=mv_nand:128K(block0)ro,1M(prebootloader)ro,4M(TZ)ro,4M(TZ-B)ro,512K(postbootloader)ro,512K(postbootloader-B)ro,8M(kernel)ro,105M(rootfs)ro,117120K(cache),15M(recovery),512K(fts)ro,2M(factory_store)ro,1M@255M(bbt)ro initrd=0x08000000,22707978
bootm 0x0c400000
