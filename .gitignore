# Bulk artifacts are preserved outside this repository by policy.
# See docs/acquisition/storage-policy.md
#
# The archive root is a sibling directory (~/reinvoke-archive), so these paths
# should never appear here. They are listed as a defensive guard only.
originals/
git-mirrors/
extracted/
web-pages/
wayback/
sources/
/emulation/

# Never commit large binary payloads.
*.zip
*.tgz
*.tar.gz
*.tar
*_IMAGE
*.img
*.bin
*.dll
*.exe

# Explicitly keep the small extracted text layer, which lives under docs/.
!docs/bundle-contents/**

# Local noise
.copilot-bt-emulation/
__pycache__/
*.pyc
.DS_Store
*.swp

# Editor settings are personal; only share project-wide configuration.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Host-specific configuration. Holds Bluetooth addresses and local paths that
# identify a particular machine, so it must never be committed. The tracked
# sample alongside it documents every supported value.
tools/usb-boot/local.conf
