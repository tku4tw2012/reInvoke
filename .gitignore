# Bulk artifacts are preserved outside this repository by policy.
# See docs/acquisition/storage-policy.md
#
# The archive root is a sibling directory (~/reinvoke-archive), so these paths
# should never appear here. They are listed as a defensive guard only.
originals/
git-mirrors/
extracted/
web-pages/
wayback/
sources/
/emulation/

# Never commit large binary payloads.
*.zip
*.tgz
*.tar.gz
*.tar
*_IMAGE
*.img
*.bin
*.dll
*.exe

# Explicitly keep the small extracted text layer, which lives under docs/.
!docs/bundle-contents/**

# Local noise
.copilot-bt-emulation/
# Keep assistant research and planning records locally, not in the public tree.
/.copilot-tracking/
__pycache__/
*.pyc
.DS_Store
*.swp
/scripts/node_modules/

# Editor settings are personal; only share project-wide configuration.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Host-specific configuration. Holds Bluetooth addresses and local paths that
# identify a particular machine, so it must never be committed. The tracked
# sample alongside it documents every supported value.
tools/usb-boot/local.conf

# Locally built service binaries. Release artifacts live in the archive and are
# pinned by checksum in the build scripts.
tools/mcu-interface/mcu-interface
tools/dsp-interface/dsp-interface
tools/provisioning/provisioning
tools/provisioning/networkd/networkd
tools/provisioning/windowd/windowd
tools/provisioning/applyd/applyd
tools/hci-down/hci-down
tools/pairing-agent/pairing-agent
tools/identifiers/identifiers
usb_boot_arm.log

# Compiled output. Three x86-64 binaries reached history this way, 9 MB in
# all, carrying the builder's home directory in their embedded paths: each
# tool is named for its directory, so `go build` with no -o drops the binary
# beside its source and a broad `git add` takes it.
#
# Named exactly rather than by shape. A pattern like /tools/*/[a-z]*[a-z]
# also matches native-ram-entry and native-ram-init, which are scripts that
# belong here; it only looked safe because tracked files are never ignored,
# so it would have hidden them the next time they were added fresh.
/status
/tools/source-manager/source-manager
/tools/nand-pilot/persistence/persistence
/tools/nand-pilot/status/status
/tools/propertyd/propertyd
/tools/keep-helper-free/keep-helper-free
