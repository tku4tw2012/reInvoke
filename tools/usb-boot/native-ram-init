BB=/bin/busybox
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

log() {
  echo "reInvoke: $*" > /dev/kmsg
}

cmdline_has() {
  case " $(${BB} cat /proc/cmdline) " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

supervise() {
  service_name="$1"
  shift
  (
    while ! ${BB} test -e /run/reinvoke/shutdown; do
      logger_pid=""
      service_log_pipe=""
      if ${BB} test -S /dev/log; then
        service_log_pipe="/run/reinvoke/logs/${service_name}.pipe"
        if ! ${BB} rm -f "${service_log_pipe}" ||
          ! ${BB} mkfifo -m 0600 "${service_log_pipe}"; then
          log "${service_name} logger setup failed"
          ${BB} sleep 5
          continue
        fi
        ${BB} logger -t "reinvoke-${service_name}" \
          <"${service_log_pipe}" &
        logger_pid="$!"
        ${BB} logger -t "reinvoke-${service_name}" \
          "start uptime=$(${BB} cut -d' ' -f1 /proc/uptime)"
        "$@" >"${service_log_pipe}" 2>&1 &
      else
        log "${service_name} using bounded kernel-log fallback"
        "$@" >/dev/kmsg 2>&1 &
      fi
      service_pid="$!"
      echo "${service_pid}" >"/run/reinvoke/${service_name}.pid"
      if ${BB} test -e /run/reinvoke/shutdown; then
        ${BB} kill "${service_pid}" 2>/dev/null || true
      fi
      wait "${service_pid}"
      service_status="$?"
      if ${BB} test -n "${logger_pid}"; then
        wait "${logger_pid}"
        logger_status="$?"
        if ${BB} test "${logger_status}" -ne 0; then
          log "${service_name} logger exited ${logger_status}"
        fi
        ${BB} rm -f "${service_log_pipe}"
      fi
      ${BB} rm -f "/run/reinvoke/${service_name}.pid"
      log "${service_name} exited ${service_status}"
      if ! ${BB} test -e /run/reinvoke/shutdown; then
        ${BB} sleep 5
      fi
    done
  ) &
  echo "$!" >"/run/reinvoke/${service_name}-supervisor.pid"
  log "${service_name} supervisor started"
}

start_runtime_logger() {
  (
    while ! ${BB} test -e /run/reinvoke/shutdown; do
      ${BB} syslogd -n -S \
        -O /run/reinvoke/logs/runtime.log -s 256 -b 1 &
      runtime_logger_pid="$!"
      echo "${runtime_logger_pid}" >/run/reinvoke/syslogd.pid
      if ${BB} test -e /run/reinvoke/shutdown; then
        ${BB} kill "${runtime_logger_pid}" 2>/dev/null || true
      fi
      wait "${runtime_logger_pid}"
      runtime_logger_status="$?"
      ${BB} rm -f /run/reinvoke/syslogd.pid
      log "runtime logger exited ${runtime_logger_status}"
      if ! ${BB} test -e /run/reinvoke/shutdown; then
        ${BB} sleep 5
      fi
    done
  ) &
  echo "$!" >/run/reinvoke/syslogd-supervisor.pid

  runtime_logger_attempt=0
  while ! ${BB} test -S /dev/log &&
    ${BB} test "${runtime_logger_attempt}" -lt 5; do
    ${BB} sleep 1
    runtime_logger_attempt=$((runtime_logger_attempt + 1))
  done
  ${BB} test -S /dev/log
}

stop_service() {
  stop_name="$1"
  stop_pid_file="/run/reinvoke/${stop_name}.pid"
  if ${BB} test -f "${stop_pid_file}"; then
    ${BB} kill "$(${BB} cat "${stop_pid_file}")" 2>/dev/null || true
  fi
}

wait_service_stop() {
  wait_name="$1"
  wait_pid_file="/run/reinvoke/${wait_name}.pid"
  wait_attempt=0
  while ${BB} test -f "${wait_pid_file}" &&
    ${BB} kill -0 "$(${BB} cat "${wait_pid_file}")" 2>/dev/null &&
    ${BB} test "${wait_attempt}" -lt 5; do
    ${BB} sleep 1
    wait_attempt=$((wait_attempt + 1))
  done
  if ${BB} test -f "${wait_pid_file}" &&
    ${BB} kill -0 "$(${BB} cat "${wait_pid_file}")" 2>/dev/null; then
    log "${wait_name} did not stop within the mute-first deadline"
  fi
}

stop_runtime() {
  ${BB} touch /run/reinvoke/shutdown
  log "stopping autonomous runtime with mute-first service order"
  if ${BB} test -f /run/reinvoke/bluetooth-bootstrap.pid; then
    ${BB} kill \
      "$(${BB} cat /run/reinvoke/bluetooth-bootstrap.pid)" 2>/dev/null || true
  fi
  stop_service mcu-interface
  wait_service_stop mcu-interface
  for stop_attempt in 1 2; do
    for service_name in dsp-interface pairing-agent \
      bluealsa-aplay bluealsa bluetoothd dbus bonefish networkd; do
      stop_service "${service_name}"
    done
    ${BB} sleep 1
  done
  stop_service syslogd
}

start_autonomous_runtime() {
  runtime_root=/opt/reinvoke
  runtime_bin="${runtime_root}/bin"
  runtime_lib="${runtime_root}/lib"
  runtime_loader="${runtime_lib}/ld-linux-armhf.so.3"
  runtime_bus=unix:path=/run/reinvoke/dbus/system_bus_socket

  if ! ${BB} test -x "${runtime_bin}/reinvoke-mcu-interface" ||
     ! ${BB} test -x "${runtime_bin}/reinvoke-dsp-interface" ||
     ! ${BB} test -x "${runtime_loader}" ||
     ! ${BB} test -f "${runtime_root}/etc/runtime.conf"; then
    log "autonomous runtime bundle is incomplete"
    return
  fi

  . "${runtime_root}/etc/runtime.conf"
  if [ -z "${PEER_ADDRESS:-}" ] || [ -z "${PAIR_SECONDS:-}" ]; then
    log "autonomous runtime configuration is invalid"
    return
  fi
  ${BB} mkdir -p /run/reinvoke/dbus /run/reinvoke/logs \
    /usr/var/lib/bluetooth
  ${BB} chmod 0700 /run/reinvoke/dbus /run/reinvoke/logs \
    /usr/var/lib/bluetooth
  if ! cmdline_has reinvoke.router=off; then
    supervise bonefish \
      "${runtime_loader}" --library-path "${runtime_lib}" \
      "${runtime_bin}/bonefish" -r default -t 9999 -w 9998 -d
  fi
  if ! cmdline_has reinvoke.mcu=off; then
    supervise mcu-interface \
      ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
      "${runtime_bin}/reinvoke-mcu-interface" \
      --router-host 127.0.0.1 --router-port 9999 \
      --bluealsa-cli "${runtime_bin}/bluealsa-cli" \
      --bluealsa-peer "${PEER_ADDRESS}" \
      --playback-status /proc/asound/card1/pcm0p/sub0/status \
      --playback-lease /run/reinvoke/bluealsa-playback-active \
      --playback-owner-executable "${runtime_bin}/bluealsa-aplay" \
      --pairing-agent-pid /run/reinvoke/pairing-agent.pid \
      --pairing-agent-executable "${runtime_bin}/bluez-pairing-agent" \
      --lights-dir "${runtime_root}/share/lights"
  fi
  if ! cmdline_has reinvoke.dsp=off; then
    supervise dsp-interface \
      "${runtime_bin}/reinvoke-dsp-interface" \
      -image "${runtime_root}/share/dsp-img.ldr" \
      -boot-state /run/reinvoke/dsp-booted \
      -router-host 127.0.0.1 -router-port 9999
  fi
  if ! cmdline_has reinvoke.bluetooth=off; then
    supervise dbus \
      "${runtime_loader}" --library-path "${runtime_lib}" \
      "${runtime_bin}/dbus-daemon" \
      --config-file="${runtime_root}/etc/dbus-session.conf" \
      --nofork --nopidfile
    ${BB} rm -f /run/reinvoke/bluetooth-bootstrap.pid
    (
      trap '${BB} rm -f /run/reinvoke/bluetooth-bootstrap.pid' EXIT
      trap 'exit 0' TERM INT
      while ! ${BB} test -f /run/reinvoke/bluetooth-bootstrap.pid; do
       ${BB} sleep 1
      done
      while ! ${BB} test -e /run/reinvoke/shutdown &&
        { ! ${BB} test -L /sys/class/bluetooth/hci0 ||
          ! ${BB} test -S /run/reinvoke/dbus/system_bus_socket; }; do
        ${BB} sleep 1
      done
      ${BB} test -e /run/reinvoke/shutdown && exit 0
      until ${BB} test -e /run/reinvoke/shutdown ||
        "${runtime_bin}/hci-init" --reset; do
        log "HCI initialization failed; retrying"
        ${BB} sleep 5
      done
      ${BB} test -e /run/reinvoke/shutdown && exit 0
      supervise bluetoothd \
        ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
        "${runtime_bin}/bluetoothd" -n -p a2dp,avrcp \
        -f "${runtime_root}/etc/bluez-main.conf"
      supervise bluealsa \
        ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
        "${runtime_bin}/bluealsa" -p a2dp-sink -i hci0 \
        --initial-volume=0
      until ${BB} test -e /run/reinvoke/shutdown ||
        ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
          "${runtime_bin}/bluealsa-cli" list-services 2>/dev/null |
          ${BB} grep -q '^org\.bluealsa$'; do
        ${BB} sleep 1
      done
      ${BB} test -e /run/reinvoke/shutdown && exit 0
      supervise bluealsa-aplay \
        ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
        REINVOKE_PLAYBACK_LEASE=/run/reinvoke/bluealsa-playback-active \
        "${runtime_bin}/bluealsa-aplay" -D plughw:1,0 \
        "${PEER_ADDRESS}"
      supervise pairing-agent \
        ${BB} env DBUS_SYSTEM_BUS_ADDRESS="${runtime_bus}" \
        "${runtime_bin}/bluez-pairing-agent" \
        "${PEER_ADDRESS}" "${PAIR_SECONDS}" "${PAIR_SECONDS}"
    ) &
    echo "$!" >/run/reinvoke/bluetooth-bootstrap.pid
    log "Bluetooth runtime bootstrap started"
  fi
}

${BB} mount -t proc proc /proc
${BB} mount -t sysfs sysfs /sys
${BB} mount -t tmpfs devtmpfs /dev
${BB} mkdir -p /dev/pts /tmp /run /run/reinvoke /data/local/tmp
${BB} chmod 0700 /run/reinvoke
${BB} mount -t devpts devpts /dev/pts
${BB} mount -t tmpfs tmpfs /tmp
# Minimal devtmpfs images may omit the kernel random devices required by D-Bus.
${BB} test -e /dev/random || ${BB} mknod -m 0444 /dev/random c 1 8
${BB} test -e /dev/urandom || ${BB} mknod -m 0444 /dev/urandom c 1 9

(umask 0; /sbin/ueventd -s)
${BB} ifconfig lo 127.0.0.1 up

for mtd_path in /sys/class/mtd/mtd[0-9]*; do
  if ! ${BB} test -f "${mtd_path}/dev"; then
    continue
  fi
  if [ "$(${BB} cat "${mtd_path}/name")" != "mv_nand" ] ||
     [ "$(${BB} cat "${mtd_path}/size")" != "268435456" ]; then
    continue
  fi

  old_ifs="${IFS}"
  IFS=:
  set -- $(${BB} cat "${mtd_path}/dev")
  IFS="${old_ifs}"
  if [ "$1" = "90" ] && [ $(($2 % 2)) -eq 0 ]; then
    ${BB} rm -f /dev/reinvoke-nand-ro
    ${BB} mknod -m 0400 /dev/reinvoke-nand-ro c "$1" $(($2 + 1))
    log "read-only NAND node uses major $1 minor $(($2 + 1))"
    break
  fi
done

for unsafe_mtd_node in /dev/mtd[0-9]* /dev/mtdblock[0-9]* \
  /dev/mtd/mtd[0-9]* /dev/mtd/mtdblock[0-9]*; do
  ${BB} rm -f "${unsafe_mtd_node}"
done

if ${BB} test -d /sys/class/android_usb/android0; then
  echo 0 > /sys/class/android_usb/android0/enable
  echo 0d02 > /sys/class/android_usb/android0/idProduct
  echo "reInvoke RAM diagnostics" > /sys/class/android_usb/android0/iProduct
  echo acm,adb > /sys/class/android_usb/android0/functions
  echo 1 > /sys/class/android_usb/android0/f_acm/instances
  echo 1 > /sys/class/android_usb/android0/enable
  /sbin/adbd-root &
else
  log "Android USB gadget is unavailable"
fi

wifi_dir=/lib/firmware/mrvl
wifi_mode=sta
sd8887_module_dir=""
sd8801_module_dir=""
bt_module=""

for candidate in \
  /lib/modules/3.8.13-reinvoke*/kernel/arch/arm/mach-berlin/modules/wlan_sd8887; do
  if ${BB} test -f "${candidate}/mlan.ko" &&
     ${BB} test -f "${candidate}/sd8xxx.ko"; then
    sd8887_module_dir="${candidate}"
    break
  fi
done

case " $(${BB} cat /proc/cmdline) " in
  *" reinvoke.wifi_mode=sta-uap "*)
    wifi_mode=sta-uap
    ;;
esac

for candidate in \
  /lib/modules/3.8.13-reinvoke*/kernel/arch/arm/mach-berlin/modules/wlan_sd8801 \
  /lib/modules/3.8.13-mrvl/kernel/arch/arm/mach-berlin/modules/wlan_sd8801; do
  if ${BB} test -f "${candidate}/88mlan.ko" &&
     ${BB} test -f "${candidate}/sd8801.ko"; then
    sd8801_module_dir="${candidate}"
    break
  fi
done

for candidate in \
  /lib/modules/3.8.13-reinvoke*/extra/bt8xxx.ko \
  /lib/modules/3.8.13-reinvoke*/kernel/arch/arm/mach-berlin/modules/bt_sd8887/bt8xxx.ko; do
  if ${BB} test -f "${candidate}"; then
    bt_module="${candidate}"
    break
  fi
done

if ! ${BB} test -f "${wifi_dir}/sd8887_wlan_a2_p78.bin" ||
   ! ${BB} test -f "${wifi_dir}/WlanCalData_ext-LS9AD-20160725.conf" ||
   ! ${BB} test -f "${wifi_dir}/txpwrlimit_cfg_8887.bin"; then
  log "SD8887 firmware bundle is incomplete"
elif [ -n "${sd8887_module_dir}" ]; then
  echo /etc/hotplug/wifi-fw.sh > /proc/sys/kernel/hotplug
  ${BB} insmod "${sd8887_module_dir}/mlan.ko" ||
    log "failed to load SD8887 mlan core"
  if [ "${wifi_mode}" = "sta-uap" ]; then
    ${BB} insmod "${sd8887_module_dir}/sd8xxx.ko" \
      fw_name=mrvl/sd8887_wlan_a2_p78.bin \
      cal_data_cfg=mrvl/WlanCalData_ext-LS9AD-20160725.conf \
      txpwrlimit_cfg=mrvl/txpwrlimit_cfg_8887.bin \
      mac_addr=02:52:49:4e:56:01 \
      drv_mode=3 max_sta_bss=1 max_uap_bss=1 \
      sta_name=mlan uap_name=p2p fw_serial=1 cfg80211_wext=0xf \
      auto_ds=2 ps_mode=2 antenna_div=1 module_rev=22 ||
      log "failed to load native SD8887 STA/uAP Wi-Fi"
  else
    ${BB} insmod "${sd8887_module_dir}/sd8xxx.ko" \
      fw_name=mrvl/sd8887_wlan_a2_p78.bin \
      cal_data_cfg=mrvl/WlanCalData_ext-LS9AD-20160725.conf \
      txpwrlimit_cfg=mrvl/txpwrlimit_cfg_8887.bin \
      mac_addr=02:52:49:4e:56:01 \
      drv_mode=1 max_sta_bss=1 max_uap_bss=0 \
      sta_name=mlan fw_serial=1 cfg80211_wext=0xf \
      auto_ds=2 ps_mode=2 antenna_div=1 module_rev=22 ||
      log "failed to load native SD8887 station Wi-Fi"
  fi
elif [ -n "${sd8801_module_dir}" ]; then
  echo /etc/hotplug/wifi-fw.sh > /proc/sys/kernel/hotplug
  ${BB} insmod "${sd8801_module_dir}/88mlan.ko" ||
    log "failed to load recovery 88mlan core"
  ${BB} insmod "${sd8801_module_dir}/sd8801.ko" \
    fw_name=mrvl/sd8887_wlan_a2_p78.bin \
    cal_data_cfg=mrvl/WlanCalData_ext-LS9AD-20160725.conf \
    txpwrlimit_cfg=mrvl/txpwrlimit_cfg_8887.bin \
    mac_addr=02:52:49:4e:56:01 \
    drv_mode=1 auto_ds=2 ps_mode=2 ||
    log "failed to load recovery SD8887-compatible Wi-Fi"
else
  log "no compatible SD8887 Wi-Fi modules found"
fi

if ! ${BB} test -f "${wifi_dir}/sd8887_bt_a2_new.bin"; then
  log "SD8887 Bluetooth firmware is missing"
elif [ -z "${bt_module}" ]; then
  log "no native SD8887 Bluetooth module found"
else
  ${BB} insmod "${bt_module}" \
    fw_name=mrvl/sd8887_bt_a2_new.bin \
    bt_fw_serial=0 ||
    log "failed to load native SD8887 Bluetooth"
fi

${BB} mkdir -p /run/reinvoke/logs
${BB} chmod 0700 /run/reinvoke/logs
if ! start_runtime_logger; then
  log "bounded runtime logger is using the kernel-log fallback"
fi

case " $(${BB} cat /proc/cmdline) " in
  *" reinvoke.networkd=off "*)
    log "owned network lifecycle service disabled by kernel command line"
    ;;
  *)
    if ${BB} test -x /usr/sbin/reinvoke-networkd; then
      ${BB} mkdir -p /run/reinvoke/logs
      supervise networkd /usr/sbin/reinvoke-networkd
    fi
    ;;
esac

if cmdline_has reinvoke.runtime=off; then
  log "autonomous runtime disabled by kernel command line"
elif ${BB} test -d /opt/reinvoke; then
  start_autonomous_runtime
fi

(
  while true; do
    if ${BB} test -c /dev/ttyGS0; then
      /bin/sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
    else
      ${BB} sleep 1
    fi
  done
) &

log "native RAM environment is running"

trap stop_runtime TERM INT
while true; do
  ${BB} sleep 1
done
