+static void playback_lease_acquire(struct pcm_worker *worker) {
+
+	if (playback_lease_path == NULL || worker->lease_active)
+		return;
+
+	pthread_mutex_lock(&playback_lease_lock);
+	if (playback_lease_users == 0) {
+		char lease[32];
+		pid_t owner = syscall(SYS_gettid);
+		int lease_len = snprintf(lease, sizeof(lease), "%d\n", owner);
+		int fd = open(playback_lease_path,
+				O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+		if (fd == -1) {
+			error("Couldn't create playback lease: %s", strerror(errno));
+			pthread_mutex_unlock(&playback_lease_lock);
+			return;
+		}
+		ssize_t written = write(fd, lease, lease_len);
+		if (written != lease_len) {
+			if (written == -1)
+				error("Couldn't write playback lease: %s", strerror(errno));
+			else
+				error("Couldn't write complete playback lease");
+			close(fd);
+			unlink(playback_lease_path);
+			pthread_mutex_unlock(&playback_lease_lock);
+			return;
+		}
+		close(fd);
+	}
+	playback_lease_users++;
+	worker->lease_active = true;
+	pthread_mutex_unlock(&playback_lease_lock);
+}
+
+static void playback_lease_release(struct pcm_worker *worker) {
+
+	if (playback_lease_path == NULL || !worker->lease_active)
+		return;
+
+	pthread_mutex_lock(&playback_lease_lock);
+	worker->lease_active = false;
+	if (playback_lease_users > 0 && --playback_lease_users == 0 &&
+			unlink(playback_lease_path) == -1 &&
+			errno != ENOENT)
+		error("Couldn't remove playback lease: %s", strerror(errno));
+	pthread_mutex_unlock(&playback_lease_lock);
+}
